{
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "express-rate-limit": "^8.2.1",
    "lucide-react": "^0.575.0",
    "mic-recorder-to-mp3": "^2.2.2",
    "react-hot-toast": "^2.6.0",
    "resend": "^6.9.2",
    "tsconfig-paths": "^4.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0"
  },
  "scripts": {
    "prepare": "husky",
    "guards:all": "node scripts/guards/run-all.mjs && node scripts/guards/guard-no-console.mjs"
  },
  "lint-staged": {
    "apps/backend/src/**/*.{ts,tsx}": [
      "node scripts/guards/guard-error-shape.mjs",
      "node scripts/guards/guard-profiles-misuse.mjs",
      "node scripts/guards/guard-quota-writes.mjs"
    ],
    "apps/frontend/src/**/*.{ts,tsx}": [
      "node scripts/guards/guard-no-console.mjs"
    ]
  }
}